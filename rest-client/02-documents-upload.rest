@baseUrl = http://localhost:3000
@apiKey = dev-key

# DOC Intelligence - Trilha A | Upload de documentos
# API Key: dev-key | Formatos: PDF, PNG, JPEG

### Upload PNG (esperado: 202)
# @name uploadPng
POST {{baseUrl}}/documents
x-api-key: {{apiKey}}
Content-Type: multipart/form-data; boundary=----DocIntelBoundary

------DocIntelBoundary
Content-Disposition: form-data; name="file"; filename="sample.png"
Content-Type: image/png

< ./fixtures/sample.png
------DocIntelBoundary--

